<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Products</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="icon" type="image" href="/images/new.png">
  <link rel="stylesheet" href="/CSS/myStyles.css">
  <!-- Custom Styles (Optional) -->
  <style>
    /* Card Container */
    .card {
      transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
      border-radius: 3px;
      overflow: hidden;
      display: flex;
      flex-direction: column; /* Ensure content stacks vertically */
      height: 100%;
    }
    .card:hover .btn-dark-cart {
      opacity: 1;
      transform: scaleY(0);
      transition: transform 1s ease-in;
      }
  
    /* Image Section */
    .card-img-top {
      flex: 2; /* Image takes up more space */
      height: auto;
      object-fit: cover;
      transition: transform 0.7s ease-out;
    }
  
    .card:hover .card-img-top {
      transform: scale(1.08);
      transition: transform 0.7s ease-in;
    }
  
    /* Card Body Section */
    .card-body {
      flex: 1; /* Card body takes up less space */
      padding: 15px;
      text-align: center;
    }
  
    .card-title {
      font-size: 1rem;
      font-weight: 600;
    }
  
    .card-text {
      font-size: 1.1rem;
    }
  
    /* Add to Cart Button */
    .btn-dark-cart {
      background-color: #212529;
      color: white;
      border: none;
      width: 100%;
      padding: 8px 15px;
      margin-top: 10px;
      border-radius: 5px;
      transition: all 0.3s ease;
      font-weight: 500;
      letter-spacing: 0.5px;
      opacity: 0;
    }
  
    .btn-dark-cart:hover {
      background-color: #000;
      transform: translateY(-2px);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }
  
    /* Responsive Adjustments */
    @media (max-width: 768px) {
      .btn-dark-cart {
        padding: 6px 12px;
        font-size: 0.85rem;
      }
    }
  </style>
  
</head>
<body>
  <!-- Container for Product Cards -->
  <div class="container mt-4">
    <!-- Title Section -->
    <h3 class="text-center mb-4 col-12 text-light justify-content-center"><%= product[0]?.category || "Products" %></h3>
    
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
      <!-- Product Cards -->
      <% product.forEach(product => { %>
        <div class="col">
          <div class="card shadow-sm h-100 border-0">
            <div class="position-relative overflow-hidden">
              <img src="/<%= product.image %>" alt="<%= product.title %>" class="card-img-top img-fluid">
            </div>
            <div class="card-body text-center">
              <h5 class="card-title mb-2 fw-bold"><%= product.title %></h5>
              <p class="text-muted mb-1 small"><%= product.category %></p>
              <p class="card-text text-dark fw-bold fs-5">Rs. <%= product.price.toLocaleString() %></p>
              <a style="text-decoration: none; margin: 10px;" href="/add-to-cart/<%= product._id %>" class="btn-dark-cart">Add To Cart</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>

  <!-- Bootstrap JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>